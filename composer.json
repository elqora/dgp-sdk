{
    "name": "elqora/dgp-sdk",
    "description": "A framework-neutral protocol for digital-product implementations with minimal framework-neutral dependencies.",
    "license": "AGPL-3.0-only",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "elqora/chart": "^1.0",
        "elqora/config-kit": "^1.0",
        "elqora/interactions": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Elqora\\Dgp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elqora\\Dgp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "check:contracts": "php scripts/check-contracts.php",
        "check": [
            "@test",
            "@analyse",
            "@check:contracts",
            "composer validate --strict"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
