{
    "name": "elqora/dgp-sdk",
    "description": "A framework-neutral protocol for digital-product implementations with minimal framework-neutral dependencies.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": ">=8.2",
        "elqora/config-kit": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Elqora\\Dgp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Elqora\\Dgp\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
